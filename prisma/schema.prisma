  aboutText2            String   @default("Samuel Abóbora é terapeuta manual especializado em osteopatia e terapias complementares, com mais de 10 anos de experiência na área.")

  // Footer
  footerDescription     String   @default("Terapias manuais especializadas para o seu bem-estar físico e mental.")
  footerEmail           String   @default("contato@samuelabobora.pt")
  footerPhone           String   @default("+351 XXX XXX XXX")

  updatedAt             DateTime @updatedAt
}
