  heroDescription       String   @default("Ajudamos a restaurar o equilíbrio do seu corpo através de terapias manuais que promovem o bem-estar físico e mental.")
  heroImageUrl          String?
  heroImagePublicId     String?

  // Secção Benefícios (Página Inicial)
  benefitsTitle         String   @default("Porque escolher as nossas terapias?")
  benefitsSubtitle      String   @default("Oferecemos tratamentos personalizados com foco no seu bem-estar total")
  benefit1Title         String   @default("Tratamento Personalizado")
  benefit1Description   String   @default("Cada sessão é adaptada às suas necessidades específicas, garantindo os melhores resultados.")
  benefit2Title         String   @default("Profissional Qualificado")
  benefit2Description   String   @default("Terapeuta certificado com vasta experiência em técnicas manuais e osteopatia.")
  benefit3Title         String   @default("Bem-Estar Integral")
  benefit3Description   String   @default("Abordagem holística que considera corpo e mente para resultados duradouros.")

  // Secção CTA (Página Inicial)
  ctaTitle              String   @default("Pronto para melhorar o seu bem-estar?")
  ctaDescription        String   @default("Agende a sua consulta hoje e comece a sentir-se melhor. Estamos aqui para ajudar na sua jornada de saúde e bem-estar.")

  // Página Sobre
  aboutTitle            String   @default("Sobre")
