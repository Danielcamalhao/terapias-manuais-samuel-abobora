generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String     @id @default(uuid())
  email                 String     @unique
  passwordHash          String
  name                  String
  role                  Role       @default(CLIENT)
  phone                 String?
  birthDate             DateTime?
  profession            String?
  addressCity           String?
  addressPost           String?
  clientType            ClientType @default(NORMAL)
  emailVerified         Boolean    @default(false)
  verificationToken     String?    @unique
  verificationExpiry    DateTime?
  // Campos para reset de password
  resetPasswordToken    String?    @unique
  resetPasswordExpiry   DateTime?
  tempPassword          String?    // Password temporária (hash) enviada por email
  mustChangePassword    Boolean    @default(false) // Flag para forçar alteração
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  bookings              Booking[]
}

model Practitioner {
  id             String         @id @default(uuid())
  name           String
  bio            String?
  photoUrl       String?
  specialties    String[]
  active         Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  availabilities Availability[]
  bookings       Booking[]
}

model Service {
  id            String    @id @default(uuid())
  name          String
  slug          String    @unique
  description   String
  durationMin   Int
  priceCents    Int
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  imageUrl      String?
  imagePublicId String?
  bookings      Booking[]
}

model Availability {
  id             String       @id @default(uuid())
  practitionerId String
  weekday        Int
  startTime      String
  endTime        String
  breakStart     String?
  breakEnd       String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  practitioner   Practitioner @relation(fields: [practitionerId], references: [id])
}

model Booking {
  id             String         @id @default(uuid())
  code           String         @unique
  userId         String
  practitionerId String?
  serviceId      String
  startAt        DateTime
  endAt          DateTime
  status         BookingStatus  @default(PENDING)
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  practitioner   Practitioner?  @relation(fields: [practitionerId], references: [id])
  service        Service        @relation(fields: [serviceId], references: [id])
  user           User           @relation(fields: [userId], references: [id])

  @@index([practitionerId, startAt])
  @@index([userId, startAt])
}

model Contact {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String?
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

enum Role {
  CLIENT
  ADMIN
}

enum ClientType {
  NORMAL
  PREMIUM
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  NO_SHOW
}

enum EmailCampaignType {
  PROMOCAO
  FERIAS
  HORARIOS
  ANIVERSARIO
  PERSONALIZADO
}

model EmailCampaign {
  id          String            @id @default(uuid())
  subject     String
  type        EmailCampaignType
  htmlContent String
  flyerUrl    String?
  targetType  ClientType?       // null = todos os clientes
  sentTo      Int               @default(0)
  sentAt      DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

// Configuração do email automático de aniversário
// Usa singleton pattern - apenas 1 registo (id = "birthday-config")
model BirthdayEmailConfig {
  id              String   @id @default("birthday-config")
  enabled         Boolean  @default(true)
  // Texto da oferta (ex: "10% de desconto", "Massagem grátis", "Vale de 15€")
  offerText       String   @default("10% de desconto na sua próxima consulta")
  // Código promocional (opcional)
  promoCode       String?  @default("ANIVERSARIO10")
  // Validade da oferta em dias
  offerValidDays  Int      @default(30)
  // URL da imagem/flyer de aniversário (Cloudinary)
  imageUrl        String?
  // Texto adicional personalizado (opcional)
  customMessage   String?
  // Última atualização
  updatedAt       DateTime @updatedAt
}

// Configurações do site (textos, imagens, etc.)
// Usa singleton pattern - apenas 1 registo (id = "site-settings")
// ============== SEGURANÇA ==============

// Audit Log para registar ações importantes
model AuditLog {
  id          String   @id @default(uuid())
  userId      String?  // null para ações anónimas (ex: tentativas de login falhadas)
  action      String   // LOGIN, LOGOUT, CREATE_USER, DELETE_USER, UPDATE_PASSWORD, etc.
  resource    String?  // Tipo de recurso afetado (User, Booking, Service, etc.)
  resourceId  String?  // ID do recurso afetado
  details     String?  // JSON com detalhes adicionais
  ipAddress   String?
  userAgent   String?
  success     Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// Rate Limiting - armazena tentativas por IP/email
model RateLimitAttempt {
  id         String   @id @default(uuid())
  identifier String   // IP ou email
  endpoint   String   // /api/login, /api/register, etc.
  attempts   Int      @default(1)
  firstAttempt DateTime @default(now())
  lastAttempt DateTime @default(now())
  blockedUntil DateTime?

  @@unique([identifier, endpoint])
  @@index([identifier])
  @@index([blockedUntil])
}

// Refresh Tokens para sessões seguras
model RefreshToken {
  id          String   @id @default(uuid())
  userId      String
  token       String   @unique
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  revokedAt   DateTime?
  replacedBy  String?  // ID do novo token (para rotação)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

// Tokens revogados (blacklist)
model RevokedToken {
  id        String   @id @default(uuid())
  jti       String   @unique // JWT ID
  expiresAt DateTime          // Quando o token original expiraria
  revokedAt DateTime @default(now())
  reason    String?           // logout, password_change, admin_revoke, etc.

  @@index([jti])
  @@index([expiresAt])
}

// ============== FIM SEGURANÇA ==============

model SiteSettings {
  id                    String   @id @default("site-settings")

  // Hero Section (Página Inicial)
  heroTitle             String   @default("Terapias Manuais")
